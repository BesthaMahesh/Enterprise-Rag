# ==========================================
# Enterprise Knowledge Intelligence Platform
# Environment Configuration
# ==========================================

# Environment
APP_ENV=development
APP_NAME=Enterprise Knowledge Intelligence Platform
DEBUG=True
LOG_LEVEL=INFO

# Database Configuration (PostgreSQL / SQLite fallback for quick local run)
DATABASE_URL=sqlite:///./enterprise_rag.db
# For PostgreSQL: postgresql://postgres:postgres@localhost:5432/enterprise_rag

# JWT Security
JWT_SECRET=your_production_jwt_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Demo User Default Passwords (Never hardcoded in logic)
DEFAULT_EMPLOYEE_PASSWORD=Employee@Acme2026!
DEFAULT_HR_PASSWORD=HRAdmin@Acme2026!
DEFAULT_FINANCE_PASSWORD=Finance@Acme2026!
DEFAULT_ADMIN_PASSWORD=AdminMaster@Acme2026!
DEFAULT_SECURITY_PASSWORD=SecuritySec@Acme2026!

# LLM Provider Configuration
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=your_llm_api_key_here
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024
LLM_TIMEOUT=30

# Embedding & Reranking Models
EMBEDDING_MODEL=all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
EMBEDDING_DEVICE=cpu
RERANKER_DEVICE=cpu

# Vector & Sparse Index Paths
VECTOR_INDEX_PATH=./indexes/dense/faiss_index.bin
VECTOR_METADATA_PATH=./indexes/dense/chunks_metadata.json
BM25_INDEX_PATH=./indexes/sparse/bm25_index.pkl

# Retrieval Parameters
TOP_K_DENSE=20
TOP_K_SPARSE=20
TOP_K_RERANK=10
FINAL_CONTEXT_K=5
MAX_CONTEXT_TOKENS=3000
RRF_K=60

# Guardrails & Reliability
ENABLE_PROMPT_INJECTION_DETECTION=True
ENABLE_PII_DETECTION=True
ENABLE_GROUNDING_CHECK=True
ENABLE_OUTPUT_GUARDRAILS=True
RATE_LIMIT_REQUESTS_PER_MINUTE=60
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIME=30

# CORS
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173", "http://127.0.0.1:3000"]
